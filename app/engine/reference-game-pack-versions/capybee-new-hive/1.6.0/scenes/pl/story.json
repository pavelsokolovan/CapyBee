      "blocks": [
        {
          "kind": "NARRATION",
          "text": "Małe światło rozjaśnia najbliższy krok. Wspomnienia dawnego domu wciąż mają swoje miejsce."
        },
        {
          "kind": "NARRATION",
          "text": "Jeśli chcesz, podziękuj po grze komuś za drobną pomoc. Możesz też odpocząć."
        },
        {
          "kind": "NARRATION",
          "text": "Ta propozycja niczego nie zapisuje ani nie zalicza."
