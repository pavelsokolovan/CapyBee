        {
          "kind": "NARRATION",
          "text": "Nowy ul, dwa światła. CapyBee rozkłada plaster miodu."
        },
        {
          "kind": "NARRATION",
          "text": "Możesz tęsknić za dawnym domem i zauważać coś nowego. Oba miejsca są ważne."
        },
        {
          "kind": "NARRATION",
          "text": "To baśń. Jej zwierzęta żyją tylko w tej historii."
        }
      ],
