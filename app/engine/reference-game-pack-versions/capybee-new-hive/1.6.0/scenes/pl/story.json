      "blocks": [
        {
          "kind": "NARRATION",
          "text": "Lampion wspomnienia i nowe światełko stoją obok siebie. Dla obu domów jest miejsce."
        },
        {
          "kind": "NARRATION",
          "text": "Jeśli chcesz, posłuchaj po grze piosenki z dawnego domu. Możesz też odpocząć w ciszy."
        },
        {
          "kind": "NARRATION",
          "text": "Ta propozycja niczego nie zapisuje ani nie zalicza."
