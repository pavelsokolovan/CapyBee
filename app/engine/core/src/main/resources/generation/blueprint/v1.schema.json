{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:capybee:generation:blueprint:v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","locale","title","premise","setting","toneTags","storyPromises","actors","state","objectives","phases","startSceneId","scenes","outcomes"],
  "properties":{
    "schemaVersion":{"const":1},"locale":{"type":"string"},"title":{"$ref":"#/$defs/short"},
    "premise":{"type":"string","minLength":1,"maxLength":1200},"setting":{"type":"string","minLength":1,"maxLength":800},
    "toneTags":{"type":"array","minItems":1,"maxItems":4,"items":{"type":"string","minLength":1,"maxLength":48}},
    "storyPromises":{"type":"array","minItems":1,"maxItems":4,"items":{"type":"string","minLength":1,"maxLength":240}},
    "actors":{"type":"array","maxItems":12,"items":{"$ref":"#/$defs/actor"}},
    "state":{"$ref":"#/$defs/state"},"objectives":{"type":"array","maxItems":8,"items":{"$ref":"#/$defs/objective"}},
    "phases":{"type":"array","minItems":5,"maxItems":5,"prefixItems":[
      {"$ref":"#/$defs/phaseOpening"},{"$ref":"#/$defs/phaseDevelopment"},{"$ref":"#/$defs/phaseChallenge"},{"$ref":"#/$defs/phaseResolution"},{"$ref":"#/$defs/phaseEnding"}]},
    "startSceneId":{"$ref":"#/$defs/symbol"},"scenes":{"type":"array","maxItems":24,"items":{"oneOf":[{"$ref":"#/$defs/decision"},{"$ref":"#/$defs/ending"}]}},
    "outcomes":{"type":"array","minItems":2,"maxItems":4,"items":{"$ref":"#/$defs/outcome"}}
  },
  "$defs":{
    "symbol":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,47}$"},"short":{"type":"string","minLength":1,"maxLength":120},
    "symbols":{"type":"array","items":{"$ref":"#/$defs/symbol"},"uniqueItems":true},
    "actor":{"type":"object","additionalProperties":false,"required":["id","name","role","description"],"properties":{"id":{"$ref":"#/$defs/symbol"},"name":{"$ref":"#/$defs/short"},"role":{"type":"string","minLength":1,"maxLength":240},"description":{"type":"string","minLength":1,"maxLength":600}}},
    "counter":{"type":"object","additionalProperties":false,"required":["id","min","max","initial"],"properties":{"id":{"$ref":"#/$defs/symbol"},"min":{"type":"integer"},"max":{"type":"integer"},"initial":{"type":"integer"}}},
    "flag":{"type":"object","additionalProperties":false,"required":["id","initial"],"properties":{"id":{"$ref":"#/$defs/symbol"},"initial":{"type":"boolean"}}},
    "set":{"type":"object","additionalProperties":false,"required":["id","values","initial"],"properties":{"id":{"$ref":"#/$defs/symbol"},"values":{"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/symbol"},"uniqueItems":true},"initial":{"type":"array","maxItems":8,"items":{"$ref":"#/$defs/symbol"},"uniqueItems":true}}},
    "state":{"type":"object","additionalProperties":false,"required":["counters","flags","sets"],"properties":{"counters":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/counter"}},"flags":{"type":"array","maxItems":12,"items":{"$ref":"#/$defs/flag"}},"sets":{"type":"array","maxItems":2,"items":{"$ref":"#/$defs/set"}}}},
    "objective":{"type":"object","additionalProperties":false,"required":["id","title","description","completeWhen"],"properties":{"id":{"$ref":"#/$defs/symbol"},"title":{"$ref":"#/$defs/short"},"description":{"type":"string","minLength":1,"maxLength":600},"completeWhen":{"$ref":"#/$defs/condition"}}},
    "phaseBase":{"type":"object","additionalProperties":false,"required":["kind","goal","development","transition","actorIds","objectiveIds"],"properties":{"kind":{"enum":["OPENING","DEVELOPMENT","CHALLENGE","RESOLUTION","ENDING"]},"goal":{"type":"string","minLength":1,"maxLength":600},"development":{"type":"string","minLength":1,"maxLength":600},"transition":{"type":"string","minLength":1,"maxLength":600},"actorIds":{"$ref":"#/$defs/symbols"},"objectiveIds":{"$ref":"#/$defs/symbols"}}},
    "phaseOpening":{"allOf":[{"$ref":"#/$defs/phaseBase"},{"properties":{"kind":{"const":"OPENING"}}}]},"phaseDevelopment":{"allOf":[{"$ref":"#/$defs/phaseBase"},{"properties":{"kind":{"const":"DEVELOPMENT"}}}]},"phaseChallenge":{"allOf":[{"$ref":"#/$defs/phaseBase"},{"properties":{"kind":{"const":"CHALLENGE"}}}]},"phaseResolution":{"allOf":[{"$ref":"#/$defs/phaseBase"},{"properties":{"kind":{"const":"RESOLUTION"}}}]},"phaseEnding":{"allOf":[{"$ref":"#/$defs/phaseBase"},{"properties":{"kind":{"const":"ENDING"}}}]},
    "sceneCommon":{"type":"object","required":["id","kind","phase","title","intent","actorIds","objectiveIds"],"properties":{"id":{"$ref":"#/$defs/symbol"},"kind":{"enum":["DECISION","ENDING"]},"phase":{"enum":["OPENING","DEVELOPMENT","CHALLENGE","RESOLUTION","ENDING"]},"title":{"$ref":"#/$defs/short"},"intent":{"type":"string","minLength":1,"maxLength":600},"actorIds":{"$ref":"#/$defs/symbols"},"objectiveIds":{"$ref":"#/$defs/symbols"}}},
    "decision":{"allOf":[{"$ref":"#/$defs/sceneCommon"},{"type":"object","additionalProperties":false,"required":["id","kind","phase","title","intent","actorIds","objectiveIds","choices"],"properties":{"id":{"$ref":"#/$defs/symbol"},"kind":{"const":"DECISION"},"phase":{"enum":["OPENING","DEVELOPMENT","CHALLENGE","RESOLUTION"]},"title":{"$ref":"#/$defs/short"},"intent":{"type":"string"},"actorIds":{"$ref":"#/$defs/symbols"},"objectiveIds":{"$ref":"#/$defs/symbols"},"choices":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/choice"}}}}]},
    "ending":{"allOf":[{"$ref":"#/$defs/sceneCommon"},{"type":"object","additionalProperties":false,"required":["id","kind","phase","title","intent","actorIds","objectiveIds","outcomeId"],"properties":{"id":{"$ref":"#/$defs/symbol"},"kind":{"const":"ENDING"},"phase":{"const":"ENDING"},"title":{"$ref":"#/$defs/short"},"intent":{"type":"string"},"actorIds":{"$ref":"#/$defs/symbols"},"objectiveIds":{"$ref":"#/$defs/symbols"},"outcomeId":{"$ref":"#/$defs/symbol"}}}]},
    "choice":{"type":"object","additionalProperties":false,"required":["id","intent","destinationSceneId","requires","effects"],"properties":{"id":{"$ref":"#/$defs/symbol"},"intent":{"type":"string","minLength":1,"maxLength":600},"destinationSceneId":{"$ref":"#/$defs/symbol"},"requires":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/condition"}]},"effects":{"type":"array","maxItems":6,"items":{"$ref":"#/$defs/effect"}}}},
    "outcome":{"type":"object","additionalProperties":false,"required":["id","resultClass","title","description"],"properties":{"id":{"$ref":"#/$defs/symbol"},"resultClass":{"enum":["SUCCESS","PARTIAL_SUCCESS","FAILURE"]},"title":{"$ref":"#/$defs/short"},"description":{"type":"string","minLength":1,"maxLength":600}}},
    "condition":{"oneOf":[
      {"$ref":"#/$defs/counterCondition"},{"$ref":"#/$defs/flagCondition"},{"$ref":"#/$defs/setContainsCondition"},{"$ref":"#/$defs/setSizeCondition"},{"$ref":"#/$defs/visitedCondition"},{"$ref":"#/$defs/compositeCondition"},{"$ref":"#/$defs/notCondition"}]},
    "counterCondition":{"type":"object","additionalProperties":false,"required":["type","counter","value"],"properties":{"type":{"enum":["COUNTER_AT_LEAST","COUNTER_AT_MOST","COUNTER_EQUALS"]},"counter":{"$ref":"#/$defs/symbol"},"value":{"type":"integer"}}},
    "flagCondition":{"type":"object","additionalProperties":false,"required":["type","flag","value"],"properties":{"type":{"const":"FLAG_IS"},"flag":{"$ref":"#/$defs/symbol"},"value":{"type":"boolean"}}},
    "setContainsCondition":{"type":"object","additionalProperties":false,"required":["type","set","value"],"properties":{"type":{"const":"SET_CONTAINS"},"set":{"$ref":"#/$defs/symbol"},"value":{"$ref":"#/$defs/symbol"}}},
    "setSizeCondition":{"type":"object","additionalProperties":false,"required":["type","set","size"],"properties":{"type":{"const":"SET_SIZE_AT_LEAST"},"set":{"$ref":"#/$defs/symbol"},"size":{"type":"integer","minimum":0}}},
    "visitedCondition":{"type":"object","additionalProperties":false,"required":["type","scene"],"properties":{"type":{"const":"VISITED_SCENE"},"scene":{"$ref":"#/$defs/symbol"}}},
    "compositeCondition":{"type":"object","additionalProperties":false,"required":["type","conditions"],"properties":{"type":{"enum":["ALL","ANY"]},"conditions":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/condition"}}}},
    "notCondition":{"type":"object","additionalProperties":false,"required":["type","condition"],"properties":{"type":{"const":"NOT"},"condition":{"$ref":"#/$defs/condition"}}},
    "effect":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["type","counter","delta"],"properties":{"type":{"const":"COUNTER_ADD"},"counter":{"$ref":"#/$defs/symbol"},"delta":{"type":"integer","not":{"const":0}}}},
      {"type":"object","additionalProperties":false,"required":["type","counter","value"],"properties":{"type":{"const":"COUNTER_SET"},"counter":{"$ref":"#/$defs/symbol"},"value":{"type":"integer"}}},
      {"type":"object","additionalProperties":false,"required":["type","flag","value"],"properties":{"type":{"const":"FLAG_SET"},"flag":{"$ref":"#/$defs/symbol"},"value":{"type":"boolean"}}},
      {"type":"object","additionalProperties":false,"required":["type","set","value"],"properties":{"type":{"enum":["SET_ADD","SET_REMOVE"]},"set":{"$ref":"#/$defs/symbol"},"value":{"$ref":"#/$defs/symbol"}}}
    ]}
  }
}
