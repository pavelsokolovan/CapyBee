    "utilitySceneIds":[],"length":{"minimumStoryTransitions":4,"maximumStoryTransitions":4},
    "completion":{"endings":[{"sceneId":"ending-success","outcomeId":"success"},{"sceneId":"ending-partial","outcomeId":"partial"}]}}
}
