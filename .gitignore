# Compiled class file
*.class
*.log

# Java build output
target/
build/
.mvn/wrapper/maven-wrapper.jar

# Node build output
node_modules/
dist/
coverage/

# Spring Boot static folder is populated at build time (Dockerfile copies Vite dist)
# Only .gitkeep is tracked to preserve the empty directory
app/server/src/main/resources/static/assets/
app/server/src/main/resources/static/index.html

# Environment files
.env
.env.*
!.env.example

# IDE files
.idea/
.vscode/
*.iml

# Keep repository metadata/config folders trackable even if excluded globally
!.github/
!.github/**

# Fly.io and Docker artifacts
.fly/
.docker/

# Operating system files
.DS_Store
Thumbs.db

# Log file
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
