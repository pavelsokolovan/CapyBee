{
  "schemaVersion": 1,
  "id": "fixture-space-courier",
  "version": "1.0.0",
  "name": "Fixture - Space Courier",
  "description": "Generated fixture with decorative assets and optional free text.",
  "locales": ["en"],
  "defaultLocale": "en",
  "features": ["GENERATION", "ASSETS"],
  "startInputs": [
    {"id": "cargo", "kind": "ENUM", "required": true, "labelKey": "input.cargo", "values": ["medicine", "mail", "seeds"]},
    {"id": "hazards", "kind": "ENUM_SET", "required": false, "labelKey": "input.hazards", "values": ["asteroids", "pirates", "solar-storm"], "maxItems": 2},
    {"id": "wish", "kind": "FREE_TEXT", "required": false, "labelKey": "input.wish", "maxChars": 140}
  ],
  "events": [{"id": "run.completed", "payload": [{"name": "summary", "type": "STRING"}, {"name": "stars", "type": "INT"}]}],
  "contentPolicy": {"freeTextAllowed": true, "audience": {"minAge": 10, "maxAge": 14}, "forbiddenTags": ["weapon"]},
  "files": ["strings/en.json", "prompts/en/system.md"]
}