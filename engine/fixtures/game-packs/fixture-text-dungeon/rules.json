{
  "schemaVersion": 1,
  "counters": [
    {
      "id": "health",
      "labelKey": "status.health",
      "min": 0,
      "max": 10,
      "initial": 10,
      "display": true,
      "maxDelta": 3
    }
  ],
  "flags": [
    { "id": "has-key", "initial": false }
  ],
  "sets": [
    { "id": "inventory", "values": ["key", "token"], "initial": [] }
  ],
  "objectives": [
    {
      "id": "escape",
      "labelKey": "objective.escape",
      "completeWhen": { "type": "VISITED_SCENE", "scene": "exit" },
      "onComplete": [
        {
          "type": "EMIT_EVENT",
          "event": "run.completed",
          "payload": { "outcome": "escaped", "health": { "counter": "health" } }
        }
      ]
    }
  ],
  "outcomes": [
    { "id": "escaped" }
  ]
}